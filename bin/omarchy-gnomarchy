#!/bin/bash

# omarchy:summary=Configure the Gnomarchy dock, or toggle GNOME mode as a whole
# omarchy:args=get <key> | set <key> <value> | toggle <key> | pin <desktop-id> | unpin <desktop-id> | set-pinned '<json-array>' | mode on|off|toggle|status | settings open|close|toggle | native build|status
# omarchy:examples=omarchy-gnomarchy get iconSize | omarchy-gnomarchy mode toggle | omarchy-gnomarchy toggle enabled | omarchy-gnomarchy settings toggle | omarchy-gnomarchy native build

set -euo pipefail

REAL_SOURCE="$(readlink -f "${BASH_SOURCE[0]}")"
PLUGIN_DIR="$(cd "$(dirname "$REAL_SOURCE")/.." && pwd)"
CONFIG="$PLUGIN_DIR/settings.json"
PLUGIN_ID="emanuel.gnomarchy"

# Presence of this file is GNOME mode's single source of truth - checked
# both here (mode status/toggle) and by looknfeel.lua's conditional block
# (extras/looknfeel-gnome.lua), so a real Hyprland config reload respects
# whatever mode was last set instead of always reapplying GNOME values.
MODE_MARKER="$PLUGIN_DIR/.gnome-mode-on"
GNOME_BUTTON_LAYOUT="appmenu:minimize,maximize,close"
DEFAULT_BUTTON_LAYOUT="appmenu:close"

# --------------------------------------------------------- native title-bar plugin
NATIVE_DIR="$PLUGIN_DIR/native/gnomarchy-bars"
NATIVE_BUILD_DIR="$PLUGIN_DIR/native/build"
NATIVE_SO="$NATIVE_BUILD_DIR/gnomarchy-bars.so"
NATIVE_STAMP="$NATIVE_BUILD_DIR/.abi-stamp"

# GTK/libadwaita apps already draw their own client-side title bar (CSD) -
# giving them hyprbars' compositor-drawn one too would stack two bars.
# Seeded from Omarchy's own default GTK apps (nvim is Omarchy's default text
# editor, a terminal app, so it needs no exception).
NO_BAR_CLASSES='^(org\\.gnome\\.Nautilus|org\\.gnome\\.NautilusPreviewer|org\\.gnome\\.Evince|org\\.gnome\\.Evince-previewer|org\\.gnome\\.DiskUtility)$'

usage() {
  cat <<USAGE
Usage: omarchy-gnomarchy <command> [args...]

  get <key>              Print the current value of a setting
  set <key> <value>      Set a scalar setting
  toggle <key>           Flip a boolean setting (enabled or pinned)
  pin <desktop-id>       Add a desktop-entry id to pinnedApps (no-op if present)
  unpin <desktop-id>     Remove a desktop-entry id from pinnedApps
  set-pinned <json>      Replace pinnedApps wholesale with a JSON array of ids
  mode on|off|toggle     Flip every GNOME-feel piece together: the plugin
                         itself (dock + workspace service), edge-to-edge
                         Hyprland tiling, GTK header-bar buttons, native
                         title bars (built/loaded on demand), floating
                         windows by default, and window drag-to-snap
  mode status            Print "on" or "off"
  settings open|close|toggle
                         Open/close/toggle the dock's settings window
  native build           Build (or rebuild) the native title-bar/snap plugin
  native status          Print whether it's built and loaded

Scalar keys: enabled, pinned, mode, iconSize, revealPx, hideDelayMs, showAppsButton

Settings live entirely in this plugin's own $CONFIG -
nothing outside the plugin's own folder is ever touched, except by
'mode', which deliberately reaches outside it: Hyprland's live config
(via 'hyprctl eval', reload-safe through \$MODE_MARKER) and the
'org.gnome.desktop.wm.preferences button-layout' gsetting.
USAGE
}

fail() {
  echo "$1" >&2
  exit 1
}

default_for() {
  case "$1" in
    enabled) echo true ;;
    pinned) echo false ;;
    mode) echo always ;;
    iconSize) echo 48 ;;
    revealPx) echo 6 ;;
    hideDelayMs) echo 500 ;;
    showAppsButton) echo true ;;
    pinnedApps) echo '["Alacritty","brave-origin","org.gnome.Nautilus"]' ;;
    *) fail "unknown key: $1" ;;
  esac
}

ensure_config() {
  [[ -f $CONFIG ]] || echo '{}' >"$CONFIG"
}

cmd_get() {
  local key="${1:-}"
  [[ -n $key ]] || { usage; exit 1; }
  if [[ ! -f $CONFIG ]]; then
    default_for "$key"
    return
  fi
  local value
  value=$(jq -r --arg k "$key" 'if has($k) and .[$k] != null then (.[$k] | if type == "array" or type == "object" then tojson else tostring end) else " " end' "$CONFIG")
  if [[ $value == " " ]]; then
    default_for "$key"
  else
    echo "$value"
  fi
}

write_value() {
  local key="$1" jsonValue="$2" tmp
  ensure_config
  tmp=$(mktemp "$PLUGIN_DIR/.settings.json.XXXXXX")
  jq --arg k "$key" --argjson v "$jsonValue" '.[$k] = $v' "$CONFIG" >"$tmp"
  mv "$tmp" "$CONFIG"
}

cmd_set() {
  local key="${1:-}" raw="${2:-}" jsonValue
  [[ -n $key && -n $raw ]] || { usage; exit 1; }
  case "$key" in
    enabled | pinned | showAppsButton)
      [[ $raw == "true" || $raw == "false" ]] || fail "value must be true or false"
      jsonValue="$raw"
      ;;
    mode)
      [[ $raw == "always" || $raw == "fullscreen" ]] || fail "mode must be always or fullscreen"
      jsonValue="\"$raw\""
      ;;
    iconSize | revealPx | hideDelayMs)
      [[ $raw =~ ^[0-9]+$ ]] || fail "value must be a non-negative integer"
      jsonValue="$raw"
      ;;
    *)
      fail "unknown key: $key (use pin/unpin/set-pinned for pinnedApps)"
      ;;
  esac
  write_value "$key" "$jsonValue"
}

cmd_toggle() {
  local key="${1:-}"
  [[ $key == "enabled" || $key == "pinned" ]] || fail "toggle only supports enabled or pinned"
  if [[ "$(cmd_get "$key")" == "true" ]]; then
    write_value "$key" "false"
  else
    write_value "$key" "true"
  fi
}

current_pinned() {
  cmd_get "pinnedApps"
}

cmd_pin() {
  local id="${1:-}"
  [[ -n $id ]] || fail "usage: omarchy-gnomarchy pin <desktop-id>"
  local next
  next=$(jq -n --argjson cur "$(current_pinned)" --arg id "$id" \
    '$cur + (if ($cur | index($id)) then [] else [$id] end)')
  write_value "pinnedApps" "$next"
}

cmd_unpin() {
  local id="${1:-}"
  [[ -n $id ]] || fail "usage: omarchy-gnomarchy unpin <desktop-id>"
  local next
  next=$(jq -n --argjson cur "$(current_pinned)" --arg id "$id" \
    '$cur - [$id]')
  write_value "pinnedApps" "$next"
}

cmd_set_pinned() {
  local raw="${1:-}"
  [[ -n $raw ]] || fail "usage: omarchy-gnomarchy set-pinned '<json-array>'"
  echo "$raw" | jq -e 'type == "array"' >/dev/null || fail "value must be a JSON array"
  write_value "pinnedApps" "$raw"
}

# --------------------------------------------------------------- mode

apply_hyprland_gnome() {
  hyprctl eval 'hl.config({general = {gaps_in = 0, gaps_out = 0, border_size = 0}})' >/dev/null 2>&1 || true
  hyprctl eval 'hl.config({decoration = {rounding = 12}})' >/dev/null 2>&1 || true
  hyprctl eval 'hl.window_rule({name = "gnomarchy-float-all", match = {class = ".*"}, float = true})' >/dev/null 2>&1 || true
  hyprctl eval "hl.window_rule({name = \"gnomarchy-no-bar\", match = {class = \"$NO_BAR_CLASSES\"}, [\"hyprbars:no_bar\"] = true})" >/dev/null 2>&1 || true
}

apply_hyprland_default() {
  hyprctl eval 'hl.config({general = {gaps_in = 5, gaps_out = 10, border_size = 2}})' >/dev/null 2>&1 || true
  hyprctl eval 'hl.config({decoration = {rounding = 0}})' >/dev/null 2>&1 || true
  # Re-invoking the same named rule with the opposite effect value is the
  # only reversal path the Lua config API offers for a live-injected rule
  # (there's no window_rule_remove) - a real Hyprland restart is the only
  # guaranteed-clean fallback if this doesn't fully take for some reason.
  hyprctl eval 'hl.window_rule({name = "gnomarchy-float-all", match = {class = ".*"}, float = false})' >/dev/null 2>&1 || true
  hyprctl eval "hl.window_rule({name = \"gnomarchy-no-bar\", match = {class = \"$NO_BAR_CLASSES\"}, [\"hyprbars:no_bar\"] = false})" >/dev/null 2>&1 || true
}

native_current_abi() {
  hyprctl version 2>/dev/null | tr -d '\n'
}

native_build() {
  mkdir -p "$NATIVE_BUILD_DIR"
  make -C "$NATIVE_DIR" clean >/dev/null 2>&1 || true
  make -C "$NATIVE_DIR" TARGET="$NATIVE_SO" || fail "native title-bar plugin failed to build"
  native_current_abi >"$NATIVE_STAMP"
}

native_ensure_built() {
  if [[ ! -f "$NATIVE_SO" || ! -f "$NATIVE_STAMP" || "$(cat "$NATIVE_STAMP")" != "$(native_current_abi)" ]]; then
    native_build
  fi
}

native_load() {
  native_ensure_built
  hyprctl plugin load "$NATIVE_SO" >/dev/null 2>&1 || true
  if ! hyprctl plugin list 2>/dev/null | grep -q "gnomarchy-bars"; then
    # Hyprland was updated since the last build - the plugin's ABI no
    # longer matches the running compositor. Rebuild once and retry.
    native_build
    hyprctl plugin load "$NATIVE_SO" || fail "native title-bar plugin failed to load after a rebuild"
  fi
}

native_unload() {
  hyprctl plugin unload "$NATIVE_SO" >/dev/null 2>&1 || true
}

cmd_mode_on() {
  touch "$MODE_MARKER"
  omarchy plugin enable "$PLUGIN_ID" >/dev/null 2>&1 || true
  native_load
  apply_hyprland_gnome
  gsettings set org.gnome.desktop.wm.preferences button-layout "$GNOME_BUTTON_LAYOUT" 2>/dev/null || true
}

cmd_mode_off() {
  rm -f "$MODE_MARKER"
  omarchy plugin disable "$PLUGIN_ID" >/dev/null 2>&1 || true
  apply_hyprland_default
  native_unload
  gsettings set org.gnome.desktop.wm.preferences button-layout "$DEFAULT_BUTTON_LAYOUT" 2>/dev/null || true
}

cmd_mode_status() {
  if [[ -f "$MODE_MARKER" ]]; then echo "on"; else echo "off"; fi
}

cmd_mode() {
  case "${1:-}" in
    on) cmd_mode_on ;;
    off) cmd_mode_off ;;
    toggle)
      if [[ -f "$MODE_MARKER" ]]; then cmd_mode_off; else cmd_mode_on; fi
      ;;
    status | get) cmd_mode_status ;;
    *) fail "usage: omarchy-gnomarchy mode on|off|toggle|status" ;;
  esac
}

# --------------------------------------------------------------- native title-bar plugin

cmd_native_status() {
  if [[ -f "$NATIVE_SO" && -f "$NATIVE_STAMP" ]]; then
    if [[ "$(cat "$NATIVE_STAMP")" == "$(native_current_abi)" ]]; then
      echo "built (up to date)"
    else
      echo "built (stale - Hyprland was updated, will rebuild on next 'mode on')"
    fi
  else
    echo "not built"
  fi
  if hyprctl plugin list 2>/dev/null | grep -q "gnomarchy-bars"; then
    echo "loaded"
  else
    echo "not loaded"
  fi
}

cmd_native() {
  case "${1:-}" in
    build) native_build ;;
    status) cmd_native_status ;;
    *) fail "usage: omarchy-gnomarchy native build|status" ;;
  esac
}

# --------------------------------------------------------------- settings window

cmd_settings() {
  local action="${1:-toggle}"
  case "$action" in
    open) omarchy-shell -q shell call "$PLUGIN_ID" openSettings '' ;;
    close) omarchy-shell -q shell call "$PLUGIN_ID" closeSettings '' ;;
    toggle) omarchy-shell -q shell call "$PLUGIN_ID" toggleSettings '' ;;
    *) fail "usage: omarchy-gnomarchy settings open|close|toggle" ;;
  esac
}

case "${1:-}" in
  get)
    shift
    cmd_get "$@"
    ;;
  set)
    shift
    cmd_set "$@"
    ;;
  toggle)
    shift
    cmd_toggle "$@"
    ;;
  pin)
    shift
    cmd_pin "$@"
    ;;
  unpin)
    shift
    cmd_unpin "$@"
    ;;
  set-pinned)
    shift
    cmd_set_pinned "$@"
    ;;
  mode)
    shift
    cmd_mode "$@"
    ;;
  settings)
    shift
    cmd_settings "$@"
    ;;
  native)
    shift
    cmd_native "$@"
    ;;
  -h | --help | "")
    usage
    exit 0
    ;;
  *)
    usage
    exit 1
    ;;
esac
